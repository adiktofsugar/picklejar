{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "picklejar",
  "compatibility_date": "2025-04-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/**", "/s3/**"],
  },
  "main": "./worker/index.ts",
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "picklejar",
      "database_id": "b267ac09-ea43-4716-8c26-1f275f67f886",
    },
  ],
  "workflows": [
    {
      "name": "sync-source-workflow",
      "binding": "SyncSourceWorkflow",
      "class_name": "SyncSourceWorkflow",
    },
    {
      "name": "process-photos-workflow",
      "binding": "ProcessPhotosWorkflow",
      "class_name": "ProcessPhotosWorkflow",
    },
  ],
  // ENCRYPTION_KEY should be set via: wrangler secret put ENCRYPTION_KEY
  "vars": {
    "ENCRYPTION_KEY": "dev-only-replace-in-production",
  },
}
